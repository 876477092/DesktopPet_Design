{
  "name": "desktop-pet",
  "private": true,
  "version": "0.1.0",
  "description": "桌面宠物 · 工程骨架与双窗口构建管线（T-01）",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:atlas": "node scripts/gen-atlas.mjs",
    "gen:sprites": "node scripts/gen-sprites.mjs",
    "gen:art": "node scripts/gen-sprites.mjs && node scripts/gen-atlas.mjs --src assets/sprites --out resources/atlas --pack"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
