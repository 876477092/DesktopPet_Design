          "type": "number",
          "format": "float"
        },
        "neglectAdd": {
          "description": "冷落压力惩罚（+6）。",
          "default": 6.0,
          "type": "number",
          "format": "float"
        },
        "rewardRatio": {
          "description": "收益比例（0.5）。",
          "default": 0.5,
          "type": "number",
          "format": "float"
        },
        "roughStep": {
          "description": "粗暴因子增量（+0.15）。",
          "default": 0.15000000596046448,
          "type": "number",
          "format": "float"
        }
      }
    },
    "SoundRefCfg": {
      "description": "音效引用（`02 §5.16` `sound`）。",
      "type": "object",
      "properties": {
