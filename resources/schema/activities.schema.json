          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TripCfg": {
      "description": "旅游目的地（`01 §6.13.5` + `02 §5.16` `trips[]`）。",
      "type": "object",
      "properties": {
        "actionIds": {
          "description": "演出动作引用（出发 `ACT-N-12` / 明信片 `ACT-N-13` / 回归 `ACT-N-14`）。",
          "default": {
            "depart": "",
            "deskLoop": "",
            "postcard": "",
            "return": ""
          },
          "allOf": [
            {
              "$ref": "#/definitions/ActionRefCfg"
            }
          ]
        },
        "cost": {
          "description": "费用（心币 + 旅行券；S8-M5 起扣款）。",
          "default": {
            "coin": 0,
            "ticketItem": ""
          },
          "allOf": [
