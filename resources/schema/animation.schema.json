          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "items": {
          "description": "微动条目（8 项 + 权重表 [25,20,15,15,10,8,5,2]）。",
          "default": [
            {
              "clip": "anim_micro_ear",
