          "type": "string"
        },
        "moveEasing": {
          "description": "位移缓动。",
          "default": "easeOutBack1.2",
          "type": "string"
        }
      }
    },
    "FadeMsCfg": {
      "description": "淡入时长范围（毫秒）。",
      "type": "object",
      "properties": {
        "default": {
