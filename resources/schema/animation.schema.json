          "default": 200,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max": {
          "description": "最长淡入（毫秒）。",
          "default": 250,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
