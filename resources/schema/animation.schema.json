          ],
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          },
          "maxItems": 2,
          "minItems": 2
        }
      }
    },
    "MicroCfg": {
      "description": "微动层（`02 §5.22`：8 种微动 + 权重表 + 情绪低落替换）。",
      "type": "object",
      "properties": {
        "intervalSec": {
