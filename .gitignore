# 依赖与构建产物
node_modules/
.pnpm-store/
target/
src-tauri/target/
src-tauri/dist/
src-tauri/gen/
dist/

# 日志与临时文件
*.log
.DS_Store
Thumbs.db

# 本地环境变量（不入库）
.env
.env.local
.env.*.local

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 占位目录：保留 .gitkeep
assets/*
!assets/.gitkeep
# S4-M6：音效资产为版本化交付物（`02 §7.7-4` 音效 OGG ≤200KB/条；`03 §2 S4-M6`
# 交付物 `assets/audio/*.ogg`），由 `scripts/gen-audio.py` 自制生成后入库。
!assets/audio/
!assets/audio/*.ogg
resources/**
!resources/.gitkeep
# S1-M5：外置配置与 JSON Schema 为版本化交付物（02 §4.2），放行两目录下的 .json。
!resources/config/
!resources/config/.gitkeep
!resources/config/*.json
!resources/schema/
!resources/schema/.gitkeep
!resources/schema/*.json

# 事故留档：2026-09-14 .git 对象库损坏的现场快照（含 reflog 等元数据，仅供手工排查，不入库）
.git-broken-*/

# 运行期临时产物
scripts_tmp/
*.log
run-dev.ps1
